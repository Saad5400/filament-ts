{
  "name": "@filament-ts/demo-app",
  "version": "0.0.1",
  "private": true,
  "description": "Demo application showcasing Filament TypeScript features",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
